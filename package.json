{
  "name": "repo-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven local PR validation agent built with the Pi Agent SDK",
  "bin": {
    "repo-sentinel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@types/node": "^22.19.19",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
